set_instance_assignment -name VIRTUAL_PIN ON -to req_ready_o
set_instance_assignment -name VIRTUAL_PIN ON -to req_i.*
set_instance_assignment -name VIRTUAL_PIN ON -to rsp_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to rsp_ready_i
set_instance_assignment -name VIRTUAL_PIN ON -to rsp_o.*
