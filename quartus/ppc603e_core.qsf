set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY ppc_core_measure
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name SEED 1
set_global_assignment -name SDC_FILE ppc603e_core.sdc

set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_fetch.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_dispatch.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_divider.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_iu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_regfile_gpr.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_rename.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_completion.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_flags.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_exception_state.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_timer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_miss_derive.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_special.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppc_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ppc_core_measure.sv

set_instance_assignment -name VIRTUAL_PIN ON -to clk_i
set_instance_assignment -name VIRTUAL_PIN ON -to rst_ni
set_instance_assignment -name VIRTUAL_PIN ON -to stimulus_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to activity_o

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
