  "conventions": {
    "bit_numbering": "A[29:31], TSIZ[0:2], DH, and DL strings preserve the manual's MSB-first numbering.",
    "address": "Queries use an already bus-side 32-bit byte address. A[29:31] is address & 7; no CPU effective-address translation, MMU translation, or cache-to-bus prediction is performed.",
    "table_lane_marks": "source_table_lane_marks records only the A marks printed in the selected table. source_table_lane_cells preserves every rendered A, em dash, x, and anomalous blank in Tables 8-6/8-7.",
    "physical_lanes": "Table 7-7 maps lanes 0,1,2,3 to DH[0:7], DH[8:15], DH[16:23], DH[24:31] and lanes 4,5,6,7 to the corresponding DL slices. Section 8.6.1 limits 32-bit mode to lanes 0 through 3.",
    "endian_scope": "Active lane numbers and physical DH/DL signal slices do not assign operand-byte significance, select an endian mode, or define memory-controller steering.",
    "decomposition": "Tables 8-5 and 8-7 each give every four-byte start. A word-boundary crossing uses a first transfer through the current four-byte word and a second transfer at the next word.",
    "doubleword_32": "The Table 8-6 doubleword is one data transaction/data tenure with two data beats. Both printed beat rows retain A[29:31]=000, TSIZ=000, and lanes 0 through 3; no second bus address is inferred.",
    "scope_rejection": "A valid processor access outside the selected rows is reported as outside_selected_tables, not architecturally invalid."
  },
