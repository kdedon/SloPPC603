# Runs Verilator, then deletes the precompiled headers left in the model
# directory. Each is about 70 MB and only speeds up the build that made it.
# Cache C++ objects when ccache is installed. The precompiled headers need
# the sloppiness settings to be cacheable.
if [ -z "${OBJCACHE+x}" ] && command -v ccache >/dev/null 2>&1; then
  export OBJCACHE=ccache
  export CCACHE_SLOPPINESS="${CCACHE_SLOPPINESS:-pch_defines,time_macros,include_file_mtime,include_file_ctime}"
fi
mdir=obj_dir
prev=
for arg in "$@"; do
  case "$prev" in
    # Verilator creates only the last directory of --Mdir; on a fresh tree
    # parallel builds would otherwise race for the parent.
    -Mdir|--Mdir) mdir=$arg; mkdir -p "$mdir" ;;
  esac
  prev=$arg
done
# PPC_VERILATOR_FLAGS adds build-wide defines (see DISPATCH_WIDTH in the
# Makefile).
case "${1:-}" in
  --version) "${VERILATOR_BIN:-verilator}" "$@" ;;
  *) "${VERILATOR_BIN:-verilator}" ${PPC_VERILATOR_FLAGS:-} "$@" ;;
esac
status=$?
if [ -d "$mdir" ]; then
  find "$mdir" -maxdepth 1 -name '*.gch' -delete
fi
exit $status
