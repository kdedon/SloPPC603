# MiSTer core for the PowerPC 603e demonstration system (docs/MISTER_CORE.md).
# sys/ is the MiSTer framework, fetched by build.sh; files.qip is generated.
set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS ON
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name OPTIMIZE_MULTI_CORNER_TIMING ON
set_global_assignment -name SEED 2

# 1920 x 1080 framebuffer in DDR3; build.sh --native removes these two for
# the 320 x 240 native-video build (docs/MISTER_CORE.md).
set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"
set_global_assignment -name VERILOG_MACRO "MISTER_FB_PALETTE=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
# Leaves out framework video features the core does not need, for area:
# composite and S-video out, adaptive scanlines and filtered downscaling.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"

# Keeps the CPU's logic together in a floating, auto-sized region, so it does
# not spread into the area the HDMI scaler and the HPS bridge place in.
set_global_assignment -name LL_ENABLED ON -section_id cpu
set_global_assignment -name LL_AUTO_SIZE ON -section_id cpu
set_global_assignment -name LL_STATE FLOATING -section_id cpu
set_global_assignment -name LL_RESERVED OFF -section_id cpu
set_global_assignment -name LL_CORE_ONLY OFF -section_id cpu
set_global_assignment -name LL_SECURITY_ROUTING_INTERFACE OFF -section_id cpu
set_global_assignment -name LL_IGNORE_IO_BANK_SECURITY_CONSTRAINT OFF -section_id cpu
set_global_assignment -name LL_PR_REGION OFF -section_id cpu
set_global_assignment -name LL_ROUTING_REGION_EXPANSION_SIZE 2147483647 -section_id cpu
set_instance_assignment -name LL_MEMBER_OF cpu -to "emu:emu|ppc603e_mister:core" -section_id cpu

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
